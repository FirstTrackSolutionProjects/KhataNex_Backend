# Server
PORT=5000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=first_track_khatanex

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Super Admin (used only by scripts/createSuperAdmin.js to seed the ONE super admin account)
# Super admin can ONLY be created/set through this backend seed script, never through
# any public API route, per the "set through backend" requirement.
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=superadmin@firsttrack.com
SUPERADMIN_PASSWORD=change_this_password

# Public base URL of THIS backend (used to build download links for
# invoice/waybill PDFs and uploaded photos returned in API responses)
BASE_URL=http://localhost:5000

# Deployed Netlify frontend URL (informational for now — CORS is left open,
# see server.js, since security hardening is deferred for now)
FRONTEND_URL=http://localhost:5173

# SMTP — used to auto-email invoices to customers.
# Example values for Gmail: host smtp.gmail.com, port 587, user = your gmail
# address, pass = a 16-character Gmail "App Password" (not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="FIRST TRACK KHATANEX <your_email@gmail.com>"

# Default company info shown on invoices/waybills (editable later via
# GET/PATCH /api/settings and the logo via POST /api/settings/logo)
COMPANY_NAME=FIRST TRACK KHATANEX
COMPANY_ADDRESS=
COMPANY_GSTIN=

# Subscription Billing & Razorpay Payment Gateway
# In Test Mode: Key ID starts with rzp_test_
# In Live Mode: Key ID starts with rzp_live_
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# Optional safety switch: prevent accidental live mode when running test environments
RAZORPAY_FORCE_TEST_MODE=true
# Development fallback: opt-in mock payment adapter when keys are absent
ALLOW_MOCK_PAYMENTS=false
# Subscription write enforcement ("on" or "off")
SUBSCRIPTION_ENFORCEMENT=on
# Subscription GST tax percentage
SUBSCRIPTION_TAX_PERCENT=18

# Two-Factor Authentication AES-256-GCM secret encryption key (32 bytes or random string)
TWO_FACTOR_ENCRYPTION_KEY=change_this_to_a_long_random_aes_secret_key
